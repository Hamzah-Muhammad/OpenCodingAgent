# Get a free key at https://build.nvidia.com (no credit card required)
NVIDIA_API_KEY=

# Optional: override the default model (deepseek-ai/deepseek-v4-flash-0731)
OPENCODINGAGENT_MODEL=

# Optional: reasoning mode for DeepSeek-style models. off (default) is fast;
# on enables hidden reasoning; auto sends no flag at all (for other models).
OPENCODINGAGENT_THINKING=
